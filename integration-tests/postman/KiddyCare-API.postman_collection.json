{
  "info": {
    "name": "KiddyCare API - Integration Tests",
    "description": "Integration tests สำหรับ KiddyCare API (Next.js). ใช้กับ Environment ที่มีตัวแปร baseUrl เช่น http://localhost:3004",
    "schema": "https://schema.postman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3004" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has ok: true', () => { const j = pm.response.json(); pm.expect(j.ok).to.eql(true); });",
                  "pm.test('Response has user', () => { const j = pm.response.json(); pm.expect(j.user).to.be.an('object'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login - Missing credentials (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Response has error', () => { const j = pm.response.json(); pm.expect(j.error).to.be.a('string'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"\",\n  \"password\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get current user (me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 401', () => { const s = pm.response.code; pm.expect([200, 401]).to.include(s); });",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Has user when authenticated', () => { const j = pm.response.json(); pm.expect(j.ok).to.eql(true); pm.expect(j.user).to.be.an('object'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has ok', () => { const j = pm.response.json(); pm.expect(j).to.have.property('ok'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has success and data', () => { const j = pm.response.json(); pm.expect(j.success).to.eql(true); pm.expect(j.data).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get orders list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 401', () => { const s = pm.response.code; pm.expect([200, 401]).to.include(s); });",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Has ok and items or stats', () => { const j = pm.response.json(); pm.expect(j).to.have.property('ok'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reorder",
      "item": [
        {
          "name": "Get reorder list (ROP/EOQ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 401', () => { const s = pm.response.code; pm.expect([200, 401]).to.include(s); });",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Has ok and items', () => { const j = pm.response.json(); pm.expect(j.ok).to.eql(true); pm.expect(j.items).to.be.an('array'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/reorder"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 401', () => { const s = pm.response.code; pm.expect([200, 401]).to.include(s); });",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Has items array', () => { const j = pm.response.json(); pm.expect(j).to.have.property('items'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Warehouses",
      "item": [
        {
          "name": "Get warehouses",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 401', () => { const s = pm.response.code; pm.expect([200, 401]).to.include(s); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/warehouses"
          }
        }
      ]
    }
  ]
}
