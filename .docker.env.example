# ============================================
# Docker Environment Variables
# สำหรับการรันด้วย Docker Compose
# ============================================
# 
# คำแนะนำ:
# 1. Development: ใช้ค่าตามนี้ได้เลย (localhost)
# 2. Production: ดู .env.production.example สำหรับคำแนะนำ
# 
# วิธีใช้:
#   cp .docker.env.example .docker.env
#   # แก้ไข .docker.env ตามต้องการ
#   docker-compose up --build -d
# ============================================

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bitterrock_db
DB_PORT=5433

# Application Configuration
APP_PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# AWS S3/R2 Configuration (Optional)
# สำหรับ file uploads - ตั้งค่าถ้าต้องการใช้ Cloudflare R2 หรือ AWS S3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

